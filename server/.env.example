# =============================================================================
# LUMINA EYEWEAR — BACKEND ENVIRONMENT CONFIGURATION (PRD v5.1 Section 9)
# Copy this file to .env and adjust variables as needed.
# =============================================================================

# Server Port and Host
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# MySQL / MariaDB (XAMPP default: 127.0.0.1:3306, user 'root', empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lumina_eyewear_db
DB_USER=root
DB_PASSWORD=

# Demo and Security Settings
DEMO_MODE=true
MAX_SNAPSHOT_SIZE_MB=5

# Payment Management — mock creates pending instructions only; it never verifies transfers.
PAYMENT_PROVIDER=mock
