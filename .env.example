# Lumina Eyewear — Multi-Source API Environment Configuration (PRD 3.3)

# 1. MockAPI.io (Products, Categories & Admin Demo CRUD)
VITE_MOCKAPI_URL=https://mockapi.io/project/lumina-demo

# 2. Postman Mock Server (Vouchers, 3D Charms & ai_face_rules)
VITE_POSTMAN_MOCK_URL=https://postman-mock-server/lumina-config

# 3. Backend API URL (Order verification & MySQL XAMPP Database)
# Note: Base URL only, do not include /api at the end
VITE_BACKEND_API_URL=http://localhost:3000
